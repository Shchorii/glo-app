# Public (baked into the static client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# fal.ai — required for Studio generate/remix (Edge Function studio-generate)
# Set as a Supabase function secret or Vault secret named FAL_KEY. Never expose to the client.
FAL_KEY=

# Optional: reserved for a future Higgsfield REST path. Higgsfield MCP is an agent connector
# (https://mcp.higgsfield.ai/mcp), not a user-facing Studio form.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Optional. Studio stores video in the Supabase `creatives` bucket today.
# Cloudflare Stream is not required for M1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# Edge Function server secrets (existing)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
