# Public (baked into the static client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CARTO_API_KEY=  # from support-basemaps@carto.com, carto.com/basemaps/apikey

# fal.ai — required for Studio generate/remix (Edge Function studio-generate)
# Set as a Supabase function secret or Vault secret named FAL_KEY. Never expose to the client.
FAL_KEY=

# Optional: reserved for a future Higgsfield REST path. Higgsfield MCP is an agent
# connector (.cursor/mcp.json → https://mcp.higgsfield.ai/mcp), not a Studio form.
# MCP authenticates via OAuth — do not put Higgsfield secrets in the client.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Optional. Instagram oEmbed is tokenless as of 2026-06-15. A user/app access token
# still raises Graph rate limits. Set as studio-embed function secret or Vault
# named META_OEMBED_TOKEN. Never expose to the client.
META_OEMBED_TOKEN=

# Optional. Studio stores video in the Supabase `creatives` bucket today.
# Cloudflare Stream is not required for M1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# Edge Function server secrets (existing)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
